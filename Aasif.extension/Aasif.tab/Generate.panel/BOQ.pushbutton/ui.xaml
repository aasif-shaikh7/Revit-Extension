<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RCC BOQ Parameter Manager"
    Width="1200"
    Height="750"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="{DynamicResource SurfaceBrush}">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER (Level Sync-style studio band: title +       -->
        <!-- subtitle left, Ember primary Export right)          -->
        <!-- ================================================= -->

        <DockPanel
            Grid.Row="0"
            Margin="10,5,10,10">

            <Button
                x:Name="ExportButton"
                DockPanel.Dock="Right"
                Content="Export Excel"
                Height="36"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                Style="{DynamicResource BrandPrimaryButton}"/>

            <StackPanel>

                <TextBlock
                    Text="RCC BOQ Parameter Manager"
                    Style="{DynamicResource BrandHeaderText}"/>

                <TextBlock
                    Text="Structural Bill of Quantities — pick the parameters to export for Beam, Column, Slab and Foundation."
                    Style="{DynamicResource BrandBodyText}"
                    Margin="0,5,0,0"/>

                <TextBlock
                    x:Name="ProjectName"
                    Text="Project:"
                    Style="{DynamicResource BrandBodyText}"
                    Margin="0,5,0,0"/>

            </StackPanel>

        </DockPanel>


        <!-- ================================================= -->
        <!-- MAIN TAB CONTROL -->
        <!-- ================================================= -->

        <TabControl
            Grid.Row="1"
            Background="{DynamicResource SurfaceBrush}"
            BorderThickness="0">


            <!-- ================================================= -->
            <!-- BEAM -->
            <!-- ================================================= -->

            <TabItem
                Header="Beam">

                <Grid
                    Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- AVAILABLE -->

                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="BeamSearch"
                                Grid.Row="0"
                                Margin="5"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ListBox
                                x:Name="BeamAvailable"
                                Grid.Row="1"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>


                    <!-- BUTTONS -->

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button
                            x:Name="BeamAdd"
                            Content="Add →"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="BeamRemove"
                            Content="← Remove"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator
                            Margin="0,8"/>

                        <Button
                            x:Name="BeamUp"
                            Content="↑ Up"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="BeamDown"
                            Content="↓ Down"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="BeamTop"
                            Content="⇧ Top"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="BeamBottom"
                            Content="⇩ Bottom"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>


                    <!-- SELECTED -->

                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="BeamSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- COLUMN -->
            <!-- ================================================= -->

            <TabItem
                Header="Column">

                <Grid
                    Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="ColumnSearch"
                                Grid.Row="0"
                                Margin="5"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ListBox
                                x:Name="ColumnAvailable"
                                Grid.Row="1"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>


                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button
                            x:Name="ColumnAdd"
                            Content="Add →"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="ColumnRemove"
                            Content="← Remove"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator
                            Margin="0,8"/>

                        <Button
                            x:Name="ColumnUp"
                            Content="↑ Up"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="ColumnDown"
                            Content="↓ Down"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="ColumnTop"
                            Content="⇧ Top"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="ColumnBottom"
                            Content="⇩ Bottom"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>


                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="ColumnSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- SLAB -->
            <!-- ================================================= -->

            <TabItem
                Header="Slab">

                <Grid
                    Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="SlabSearch"
                                Grid.Row="0"
                                Margin="5"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ComboBox
                                x:Name="SlabFilter"
                                Grid.Row="1"
                                Margin="5"
                                Style="{DynamicResource BrandComboBox}"
                                ToolTip="Filter Slab / Fold Slab / Grade Slab"/>

                            <ListBox
                                x:Name="SlabAvailable"
                                Grid.Row="2"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>


                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button
                            x:Name="SlabAdd"
                            Content="Add →"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="SlabRemove"
                            Content="← Remove"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator
                            Margin="0,8"/>

                        <Button
                            x:Name="SlabUp"
                            Content="↑ Up"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="SlabDown"
                            Content="↓ Down"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="SlabTop"
                            Content="⇧ Top"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="SlabBottom"
                            Content="⇩ Bottom"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>


                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="SlabSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- FOUNDATION -->
            <!-- ================================================= -->

            <TabItem
                Header="Foundation">

                <Grid
                    Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="FoundationSearch"
                                Grid.Row="0"
                                Margin="5"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ComboBox
                                x:Name="FoundationFilter"
                                Grid.Row="1"
                                Margin="5"
                                Style="{DynamicResource BrandComboBox}"
                                ToolTip="Filter Footing / Combined Footing / PCC / Raft / Combined Raft"/>

                            <ListBox
                                x:Name="FoundationAvailable"
                                Grid.Row="2"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>


                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button
                            x:Name="FoundationAdd"
                            Content="Add →"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="FoundationRemove"
                            Content="← Remove"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator
                            Margin="0,8"/>

                        <Button
                            x:Name="FoundationUp"
                            Content="↑ Up"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="FoundationDown"
                            Content="↓ Down"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="FoundationTop"
                            Content="⇧ Top"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="FoundationBottom"
                            Content="⇩ Bottom"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>


                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="FoundationSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


        </TabControl>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush2}"
            Background="{DynamicResource SurfaceAltBrush}">

            <DockPanel>

                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Style="{DynamicResource BrandBodyText}"
                    Text="Ready"/>


                <Button
                    x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    Content="Close"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{DynamicResource BrandSecondaryButton}"/>

                <StackPanel
                    Orientation="Horizontal"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0">

                    <TextBlock
                        Text="Theme:"
                        Style="{DynamicResource BrandLabelText}"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"/>

                    <ComboBox
                        x:Name="ThemeSelector"
                        Style="{DynamicResource BrandComboBox}"
                        MinWidth="125"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"
                        ToolTip="Choose Light or Dark, or follow Revit's own theme (Auto). The choice is saved automatically."/>

                    <TextBlock
                        Text="Options:"
                        Style="{DynamicResource BrandLabelText}"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"/>

                    <CheckBox
                        x:Name="ExportOnlyCheck"
                        Style="{DynamicResource BrandCheckBox}"
                        Content="Export selected only"
                        VerticalContentAlignment="Center"
                        Margin="0,0,16,0"
                        ToolTip="Only include elements currently selected in the Revit view."/>

                    <CheckBox
                        x:Name="AutoOpenCheck"
                        Style="{DynamicResource BrandCheckBox}"
                        Content="Open file after export"
                        VerticalContentAlignment="Center"
                        ToolTip="Automatically launch the generated Excel workbook."/>

                    <CheckBox
                        x:Name="QuantitiesCheck"
                        Style="{DynamicResource BrandCheckBox}"
                        Content="Include quantities"
                        IsChecked="True"
                        VerticalContentAlignment="Center"
                        Margin="16,0,0,0"
                        ToolTip="Append metric quantity columns (volume, area, length), styled totals rows and a live-formula BOQ Summary sheet."/>

                    <CheckBox
                        x:Name="SiteFormatCheck"
                        Style="{DynamicResource BrandCheckBox}"
                        Content="Site format"
                        IsChecked="True"
                        VerticalContentAlignment="Center"
                        Margin="16,0,0,0"
                        ToolTip="Export the manual site-style workbook (title blocks, MM size columns, VOLUME + SHUTTERING). Uncheck for the classic workbook with BOQ Summary, BOQ by Level and BOQ by Grade sheets."/>

                </StackPanel>

            </DockPanel>

        </Border>

    </Grid>

</Window>