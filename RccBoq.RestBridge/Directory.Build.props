<Project>
  <PropertyGroup>
    <Version>2.3.0</Version>
    <BridgeChannel Condition="'$(BridgeChannel)' == ''">Primary</BridgeChannel>
    <DefineConstants Condition="'$(BridgeChannel)' == 'Secondary'">$(DefineConstants);RCC_BOQ_SECONDARY</DefineConstants>
    <Authors>RCC BOQ</Authors>
    <Company>RCC BOQ</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
