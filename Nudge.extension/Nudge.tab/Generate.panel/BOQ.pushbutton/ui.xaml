<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RCC BOQ Parameter Manager"
    Width="1200"
    Height="750"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="{DynamicResource SurfaceBrush}">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER (Level Sync-style studio band: title +       -->
        <!-- subtitle left, steel primary Export right)          -->
        <!-- ================================================= -->

        <DockPanel
            Grid.Row="0"
            Margin="10,5,10,10">

            <Button
                x:Name="ExportButton"
                DockPanel.Dock="Right"
                Content="Export Excel"
                Height="36"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                Style="{DynamicResource BrandPrimaryButton}"/>

            <StackPanel>

                <TextBlock
                    Text="RCC BOQ Parameter Manager"
                    Style="{DynamicResource BrandHeaderText}"/>

                <TextBlock
                    Text="Structural Bill of Quantities — pick parameters for Beam, Column, Structure Wall, Slab, Foundation and Rebar."
                    Style="{DynamicResource BrandBodyText}"
                    Margin="0,5,0,0"/>

                <TextBlock
                    x:Name="ProjectName"
                    Text="Project:"
                    Style="{DynamicResource BrandBodyText}"
                    Margin="0,5,0,0"/>

            </StackPanel>

        </DockPanel>


        <!-- ================================================= -->
        <!-- MAIN TAB CONTROL -->
        <!-- ================================================= -->

        <TabControl
            x:Name="MainTabs"
            Grid.Row="1"
            Background="{DynamicResource SurfaceBrush}"
            BorderThickness="0">


            <!-- ================================================= -->
            <!-- BEAM -->
            <!-- ================================================= -->

            <TabItem
                Header="Beam">

                <Grid
                    Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- AVAILABLE -->

                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="BeamSearch"
                                Grid.Row="0"
                                Margin="5"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                CaretBrush="{DynamicResource TextPrimaryBrush}"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ListBox
                                x:Name="BeamAvailable"
                                Grid.Row="1"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>


                    <!-- BUTTONS -->

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button
                            x:Name="BeamAdd"
                            Content="Add &#x2192;"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="BeamRemove"
                            Content="&#x2190; Remove"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator
                            Margin="0,8"/>

                        <Button
                            x:Name="BeamUp"
                            Content="&#x2191; Up"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="BeamDown"
                            Content="&#x2193; Down"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="BeamTop"
                            Content="&#x21E7; Top"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="BeamBottom"
                            Content="&#x21E9; Bottom"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>


                    <!-- SELECTED -->

                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="BeamSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- COLUMN -->
            <!-- ================================================= -->

            <TabItem
                Header="Column">

                <Grid
                    Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="ColumnSearch"
                                Grid.Row="0"
                                Margin="5"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                CaretBrush="{DynamicResource TextPrimaryBrush}"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ListBox
                                x:Name="ColumnAvailable"
                                Grid.Row="1"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>


                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button
                            x:Name="ColumnAdd"
                            Content="Add &#x2192;"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="ColumnRemove"
                            Content="&#x2190; Remove"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator
                            Margin="0,8"/>

                        <Button
                            x:Name="ColumnUp"
                            Content="&#x2191; Up"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="ColumnDown"
                            Content="&#x2193; Down"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="ColumnTop"
                            Content="&#x21E7; Top"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="ColumnBottom"
                            Content="&#x21E9; Bottom"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>


                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="ColumnSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- STRUCTURE WALL -->
            <!-- ================================================= -->

            <TabItem Header="Structure Wall">

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="StructureWallSearch"
                                Grid.Row="0"
                                Margin="5"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                CaretBrush="{DynamicResource TextPrimaryBrush}"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ListBox
                                x:Name="StructureWallAvailable"
                                Grid.Row="1"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button
                            x:Name="StructureWallAdd"
                            Content="Add &#x2192;"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="StructureWallRemove"
                            Content="&#x2190; Remove"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator Margin="0,8"/>

                        <Button
                            x:Name="StructureWallUp"
                            Content="&#x2191; Up"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="StructureWallDown"
                            Content="&#x2193; Down"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="StructureWallTop"
                            Content="&#x21E7; Top"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="StructureWallBottom"
                            Content="&#x21E9; Bottom"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>

                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="StructureWallSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- REBAR -->
            <!-- ================================================= -->

            <TabItem Header="Rebar">

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="RebarSearch"
                                Grid.Row="0"
                                Margin="5"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                CaretBrush="{DynamicResource TextPrimaryBrush}"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ListBox
                                x:Name="RebarAvailable"
                                Grid.Row="1"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button x:Name="RebarAdd" Content="Add &#x2192;"
                                Height="38" Margin="0,5"
                                Style="{DynamicResource BrandSecondaryButton}"/>
                        <Button x:Name="RebarRemove" Content="&#x2190; Remove"
                                Height="38" Margin="0,5"
                                Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator Margin="0,8"/>

                        <Button x:Name="RebarUp" Content="&#x2191; Up"
                                Height="38" Margin="0,4"
                                Style="{DynamicResource BrandSecondaryButton}"/>
                        <Button x:Name="RebarDown" Content="&#x2193; Down"
                                Height="38" Margin="0,4"
                                Style="{DynamicResource BrandSecondaryButton}"/>
                        <Button x:Name="RebarTop" Content="&#x21E7; Top"
                                Height="38" Margin="0,4"
                                Style="{DynamicResource BrandSecondaryButton}"/>
                        <Button x:Name="RebarBottom" Content="&#x21E9; Bottom"
                                Height="38" Margin="0,4"
                                Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>

                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="RebarSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- SLAB -->
            <!-- ================================================= -->

            <TabItem
                Header="Slab">

                <Grid
                    Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="SlabSearch"
                                Grid.Row="0"
                                Margin="5"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                CaretBrush="{DynamicResource TextPrimaryBrush}"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ComboBox
                                x:Name="SlabFilter"
                                Grid.Row="1"
                                Margin="5"
                                Style="{DynamicResource BrandComboBox}"
                                ToolTip="Filter Slab / Fold Slab / Grade Slab"/>

                            <ListBox
                                x:Name="SlabAvailable"
                                Grid.Row="2"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>


                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button
                            x:Name="SlabAdd"
                            Content="Add &#x2192;"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="SlabRemove"
                            Content="&#x2190; Remove"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator
                            Margin="0,8"/>

                        <Button
                            x:Name="SlabUp"
                            Content="&#x2191; Up"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="SlabDown"
                            Content="&#x2193; Down"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="SlabTop"
                            Content="&#x21E7; Top"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="SlabBottom"
                            Content="&#x21E9; Bottom"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>


                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="SlabSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


            <!-- ================================================= -->
            <!-- FOUNDATION -->
            <!-- ================================================= -->

            <TabItem
                Header="Foundation">

                <Grid
                    Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <GroupBox
                        Grid.Column="0"
                        Header="Available Parameters"
                        Margin="0,0,8,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="FoundationSearch"
                                Grid.Row="0"
                                Margin="5"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                CaretBrush="{DynamicResource TextPrimaryBrush}"
                                Style="{DynamicResource BrandTextBox}"/>

                            <ComboBox
                                x:Name="FoundationFilter"
                                Grid.Row="1"
                                Margin="5"
                                Style="{DynamicResource BrandComboBox}"
                                ToolTip="Filter Footing / Combined Footing / PCC / Raft / Combined Raft"/>

                            <ListBox
                                x:Name="FoundationAvailable"
                                Grid.Row="2"
                                Margin="5"
                                SelectionMode="Extended"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                        </Grid>

                    </GroupBox>


                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8">

                        <Button
                            x:Name="FoundationAdd"
                            Content="Add &#x2192;"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="FoundationRemove"
                            Content="&#x2190; Remove"
                            Height="38"
                            Margin="0,5"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Separator
                            Margin="0,8"/>

                        <Button
                            x:Name="FoundationUp"
                            Content="&#x2191; Up"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="FoundationDown"
                            Content="&#x2193; Down"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="FoundationTop"
                            Content="&#x21E7; Top"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                        <Button
                            x:Name="FoundationBottom"
                            Content="&#x21E9; Bottom"
                            Height="38"
                            Margin="0,4"
                            Style="{DynamicResource BrandSecondaryButton}"/>

                    </StackPanel>


                    <GroupBox
                        Grid.Column="2"
                        Header="Selected / Export Parameters"
                        Margin="8,0,0,0">

                        <ListBox
                            x:Name="FoundationSelected"
                            Margin="5"
                            SelectionMode="Extended"
                            DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>

                    </GroupBox>

                </Grid>

            </TabItem>


            <TabItem Header="Assembly Profile">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Structural Assembly Profile" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Measured concrete, Rebar and formwork stay model-derived. Optional factors below are multiplied by hosted Rebar weight in kg; leave blank when the applicable local SOR does not define a defensible coefficient." TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="Profile name" Style="{DynamicResource BrandLabelText}"/>
                        <TextBox x:Name="AssemblyProfileName" Style="{DynamicResource BrandTextBox}" Margin="0,4,0,10"/>
                        <TextBlock Text="Authority / source reference" Style="{DynamicResource BrandLabelText}"/>
                        <TextBox x:Name="AssemblyProfileSource" Style="{DynamicResource BrandTextBox}" Margin="0,4,0,10"/>
                        <TextBlock Text="Binding wire factor (kg per kg Rebar)" Style="{DynamicResource BrandLabelText}"/>
                        <TextBox x:Name="AssemblyBindingWireFactor" Style="{DynamicResource BrandTextBox}" Margin="0,4,0,10" ToolTip="Example: 0.01 means 1 kg binding wire per 100 kg hosted Rebar."/>
                        <TextBlock Text="Cover block factor (each per kg Rebar)" Style="{DynamicResource BrandLabelText}"/>
                        <TextBox x:Name="AssemblyCoverBlockFactor" Style="{DynamicResource BrandTextBox}" Margin="0,4,0,10"/>
                        <TextBlock Text="Labour factor (worker-day per kg Rebar)" Style="{DynamicResource BrandLabelText}"/>
                        <TextBox x:Name="AssemblyLabourFactor" Style="{DynamicResource BrandTextBox}" Margin="0,4,0,10"/>
                        <TextBlock Text="Blank or invalid/negative factors export as Input required. Values and source are saved automatically and printed in the workbook." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Site Items">
                <Grid Margin="18">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Site / Non-Model Items" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SiteItemIntro" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                                   Style="{DynamicResource BrandBodyText}"
                                   Text="Work that is not modelled - consumables, temporary works, site items. These export to their own Site Items sheet and are added to the Costing total. A line without a positive Quantity and Rate still appears, but its Amount stays blank rather than counting as zero."/>
                        <TextBlock x:Name="SiteItemSource" Margin="0,6,0,0" Style="{DynamicResource BrandLabelText}" Text=""/>
                    </StackPanel>

                    <!-- Columns are paired by how much room each field needs:
                         identity, then unit/rate, then the long free text. -->
                    <Grid Grid.Row="1" Margin="0,0,0,10" MaxWidth="1100" HorizontalAlignment="Left">

                        <!-- Explicit widths: the block is left-aligned, so a
                             star column would collapse to its content and the
                             free-text fields would end up as narrow as Unit. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="620"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Code" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Unit" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Description" Style="{DynamicResource BrandLabelText}" Margin="0,0,0,2"/>

                        <TextBox x:Name="SiteItemCode" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}"/>
                        <TextBox x:Name="SiteItemUnit" Grid.Row="1" Grid.Column="1" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}" ToolTip="For example kg, LS, nos, m2."/>
                        <TextBox x:Name="SiteItemDescription" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" Style="{DynamicResource BrandTextBox}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Quantity" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Rate" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Remarks" Style="{DynamicResource BrandLabelText}" Margin="0,0,0,2"/>

                        <TextBox x:Name="SiteItemQuantity" Grid.Row="3" Grid.Column="0" Margin="0,0,10,0" Style="{DynamicResource BrandTextBox}"/>
                        <TextBox x:Name="SiteItemRate" Grid.Row="3" Grid.Column="1" Margin="0,0,10,0" Style="{DynamicResource BrandTextBox}" ToolTip="Leave blank while a rate is still awaited. The line exports with a blank Amount."/>
                        <TextBox x:Name="SiteItemRemarks" Grid.Row="3" Grid.Column="2" Margin="0,0,0,0" Style="{DynamicResource BrandTextBox}"/>

                    </Grid>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Items in this project" Margin="0,0,8,0">
                            <ListBox
                                x:Name="SiteItemList"
                                Margin="5"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>
                        </GroupBox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="150">
                            <Button x:Name="SiteItemAdd" Content="Add item" Height="34" Margin="0,0,0,6" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="SiteItemUpdate" Content="Update selected" Height="34" Margin="0,0,0,6" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="SiteItemRemove" Content="Remove selected" Height="34" Margin="0,0,0,6" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="SiteItemClear" Content="Clear fields" Height="34" Margin="0,0,0,14" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="SiteItemSaveDefault" Content="Save as default" Height="34" Margin="0,0,0,0" Style="{DynamicResource BrandSecondaryButton}"
                                    ToolTip="Use this list to start any NEW project. Projects that already have their own list are never changed."/>
                        </StackPanel>

                    </Grid>

                    <TextBlock x:Name="SiteItemSummary" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"
                               Style="{DynamicResource BrandBodyText}" Text="No site items."/>

                </Grid>
            </TabItem>

            <TabItem Header="Rate Analysis">
                <Grid Margin="18">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Rate Analysis" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RateIntro" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                                   Style="{DynamicResource BrandBodyText}"
                                   Text="Where a rate comes from. Wastage applies to the material only - labour and machinery are not wasted - and overheads apply to everything under them. An item missing any of the five is kept, but its rate stays blank rather than being priced at zero."/>
                        <TextBlock x:Name="RateSource" Margin="0,6,0,0" Style="{DynamicResource BrandLabelText}" Text=""/>
                    </StackPanel>

                    <!-- Same column pairing as Site Items: identity, then the
                         short numbers, then the long free text. -->
                    <Grid Grid.Row="1" Margin="0,0,0,10" MaxWidth="1100" HorizontalAlignment="Left">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="620"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Code" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Unit" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Description" Style="{DynamicResource BrandLabelText}" Margin="0,0,0,2"/>

                        <TextBox x:Name="RateItemCode" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}"/>
                        <TextBox x:Name="RateUnit" Grid.Row="1" Grid.Column="1" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}" ToolTip="For example m3, m2, kg."/>
                        <TextBox x:Name="RateDescription" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" Style="{DynamicResource BrandTextBox}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Material (per unit)" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Wastage %" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Labour (per unit)" Style="{DynamicResource BrandLabelText}" Margin="0,0,0,2"/>

                        <TextBox x:Name="RateMaterial" Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}"/>
                        <TextBox x:Name="RateWastagePct" Grid.Row="3" Grid.Column="1" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}" ToolTip="Applied to the material only."/>
                        <TextBox x:Name="RateLabour" Grid.Row="3" Grid.Column="2" Margin="0,0,0,10" Style="{DynamicResource BrandTextBox}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Machinery (per unit)" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Overheads %" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>

                        <TextBox x:Name="RateMachinery" Grid.Row="5" Grid.Column="0" Margin="0,0,10,0" Style="{DynamicResource BrandTextBox}"/>
                        <TextBox x:Name="RateOverheadsPct" Grid.Row="5" Grid.Column="1" Margin="0,0,10,0" Style="{DynamicResource BrandTextBox}" ToolTip="Applied to material + wastage + labour + machinery."/>

                    </Grid>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Rate build-ups" Margin="0,0,8,0">
                            <ListBox
                                x:Name="RateList"
                                Margin="5"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>
                        </GroupBox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="150">
                            <Button x:Name="RateAdd" Content="Add item" Height="34" Margin="0,0,0,6" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="RateUpdate" Content="Update selected" Height="34" Margin="0,0,0,6" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="RateRemove" Content="Remove selected" Height="34" Margin="0,0,0,6" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="RateClear" Content="Clear fields" Height="34" Margin="0,0,0,0" Style="{DynamicResource BrandSecondaryButton}"/>
                        </StackPanel>

                    </Grid>

                    <TextBlock x:Name="RateSummary" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"
                               Style="{DynamicResource BrandBodyText}" Text="No rate build-ups."/>

                </Grid>
            </TabItem>

            <TabItem Header="Rate Database">
                <Grid Margin="18">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Rate Database" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RateDbIntro" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                                   Style="{DynamicResource BrandBodyText}"
                                   Text="Your rates, with where and from when each one applies. A rate for a city, a state or a country: a project looks for its city first, then its state, then its country, then a rate with no location. A later Effective Date replaces an earlier one from that day. Write &quot;SAMPLE&quot; in Source for a test figure and the workbook marks it as not a real rate. The Detailed BOQ looks up these codes, most specific first: RCC-M30-BEAM then RCC-M30 for concrete, SHUT-SLAB then SHUT for shuttering, STEEL-12 then STEEL for reinforcement."/>
                        <TextBlock x:Name="RateDbSource" Margin="0,6,0,0" Style="{DynamicResource BrandLabelText}" Text=""/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="This project's location" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Style="{DynamicResource BrandLabelText}"/>
                        <TextBox x:Name="RateDbProjectLocation" Width="420" Style="{DynamicResource BrandTextBox}"
                                 ToolTip="City, State, Country - for example Navsari, Gujarat, India or Dubai, UAE."/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,10" MaxWidth="1100" HorizontalAlignment="Left">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="470"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Code" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Unit" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Rate (per unit)" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Description" Style="{DynamicResource BrandLabelText}" Margin="0,0,0,2"/>

                        <TextBox x:Name="RateDbItemCode" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}"/>
                        <TextBox x:Name="RateDbUnit" Grid.Row="1" Grid.Column="1" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}" ToolTip="For example m3, m2, kg."/>
                        <TextBox x:Name="RateDbRate" Grid.Row="1" Grid.Column="2" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}"/>
                        <TextBox x:Name="RateDbDescription" Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" Style="{DynamicResource BrandTextBox}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Location" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Currency" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Effective Date" Style="{DynamicResource BrandLabelText}" Margin="0,0,10,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Vendor" Style="{DynamicResource BrandLabelText}" Margin="0,0,0,2"/>

                        <TextBox x:Name="RateDbLocation" Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}"
                                 ToolTip="A city, state or country - or blank for a rate that applies anywhere."/>
                        <TextBox x:Name="RateDbCurrency" Grid.Row="3" Grid.Column="1" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}" ToolTip="For example INR, AED, USD."/>
                        <TextBox x:Name="RateDbEffectiveDate" Grid.Row="3" Grid.Column="2" Margin="0,0,10,10" Style="{DynamicResource BrandTextBox}" ToolTip="YYYY-MM-DD, for example 2026-09-22. Blank means no date."/>
                        <TextBox x:Name="RateDbVendor" Grid.Row="3" Grid.Column="3" Margin="0,0,0,10" Style="{DynamicResource BrandTextBox}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Text="Source (SOR, quotation, or SAMPLE)" Style="{DynamicResource BrandLabelText}" Margin="0,0,0,2"/>
                        <TextBox x:Name="RateDbSourceText" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,0" Style="{DynamicResource BrandTextBox}"/>

                    </Grid>

                    <Grid Grid.Row="3">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Rates" Margin="0,0,8,0">
                            <ListBox
                                x:Name="RateDbList"
                                Margin="5"
                                DisplayMemberPath="Name"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"/>
                        </GroupBox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="150">
                            <Button x:Name="RateDbAdd" Content="Add rate" Height="34" Margin="0,0,0,6" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="RateDbUpdate" Content="Update selected" Height="34" Margin="0,0,0,6" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="RateDbRemove" Content="Remove selected" Height="34" Margin="0,0,0,6" Style="{DynamicResource BrandSecondaryButton}"/>
                            <Button x:Name="RateDbClear" Content="Clear fields" Height="34" Margin="0,0,0,0" Style="{DynamicResource BrandSecondaryButton}"/>
                        </StackPanel>

                    </Grid>

                    <TextBlock x:Name="RateDbSummary" Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap"
                               Style="{DynamicResource BrandBodyText}" Text="No rates."/>

                </Grid>
            </TabItem>

        </TabControl>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush2}"
            Background="{DynamicResource SurfaceAltBrush}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{DynamicResource BrandBodyText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                    Text="Ready"/>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0">

                    <TextBlock
                        Text="Theme:"
                        Style="{DynamicResource BrandLabelText}"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"/>

                    <ComboBox
                        x:Name="ThemeSelector"
                        Style="{DynamicResource BrandComboBox}"
                        MinWidth="125"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"
                        ToolTip="Choose Light or Dark, or follow Revit's own theme (Auto). The choice is saved automatically."/>

                    <TextBlock
                        Text="Options:"
                        Style="{DynamicResource BrandLabelText}"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"/>

                    <CheckBox
                        x:Name="ExportOnlyCheck"
                        Style="{DynamicResource BrandCheckBox}"
                        Content="Export selected only"
                        VerticalContentAlignment="Center"
                        Margin="0,0,16,0"
                        ToolTip="Only include elements currently selected in the Revit view."/>

                    <CheckBox
                        x:Name="AutoOpenCheck"
                        Style="{DynamicResource BrandCheckBox}"
                        Content="Open file after export"
                        VerticalContentAlignment="Center"
                        ToolTip="Automatically launch the generated Excel workbook."/>

                    <CheckBox
                        x:Name="QuantitiesCheck"
                        Style="{DynamicResource BrandCheckBox}"
                        Content="Include quantities"
                        IsChecked="True"
                        VerticalContentAlignment="Center"
                        Margin="16,0,0,0"
                        ToolTip="Append metric quantity columns (volume, area, length), styled totals rows and a live-formula BOQ Summary sheet."/>

                    <CheckBox
                        x:Name="SiteFormatCheck"
                        Style="{DynamicResource BrandCheckBox}"
                        Content="Site format"
                        IsChecked="True"
                        VerticalContentAlignment="Center"
                        Margin="16,0,0,0"
                        ToolTip="Export the manual site-style workbook (title blocks, MM size columns, VOLUME + SHUTTERING). Uncheck for the classic workbook with BOQ Summary, BOQ by Level and BOQ by Grade sheets."/>

                    <CheckBox
                        x:Name="IncludeFormworkCheck"
                        Style="{DynamicResource BrandCheckBox}"
                        Content="Include formwork"
                        IsChecked="True"
                        VerticalContentAlignment="Center"
                        Margin="16,0,0,0"
                        ToolTip="Compute the SHUTTERING (formwork contact area, m2) column in the site-format workbook: Column 2(L+W)H, Beam (W+2H)L, Slab soffit, Foundation sides. Per-category junction deduction percentages live in the settings file under 'formwork'."/>

                </StackPanel>

                <Button
                    x:Name="CloseButton"
                    Grid.Column="2"
                    Content="Close"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Style="{DynamicResource BrandSecondaryButton}"/>

            </Grid>

        </Border>

    </Grid>

</Window>
