<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Plum & Peach palette - LIGHT (v1.33.0, the owner's choice)

        Tier 1 primitives, then Tier 2 semantic brushes. Controls reference
        the semantic brushes only, so a palette change never touches a
        control template.

        Primary  Plum          #6B2D5C  white on it 9.7:1  - actions, focus, checkboxes
        Peach    selection     #FDE9DE  plum text on it 11.5:1 - selected list items
        Accent   Deep Peach    #D9744A  3.2:1 on white     - the active-tab underline and
                                                             thin rules only; never text
                 (true peach #F4A582 is 2.0:1 on white - too faint for a line here;
                  the Dark theme uses it, where it reaches 7.1:1)
        Graphite               #1E2329  15.8:1 on white    - headings, header band
        Concrete               #5B6470  6.0:1 on white     - secondary text

        Error red stays well apart from both brand colours, so red always
        means something went wrong.
    -->

    <!-- ===== Tier 1: brand primitives ===== -->
    <Color x:Key="Primary500Color">#6B2D5C</Color>
    <Color x:Key="Primary600Color">#5A2550</Color>
    <Color x:Key="Primary700Color">#4A1F40</Color>
    <Color x:Key="Primary100Color">#F3E6EF</Color>
    <Color x:Key="Primary900Color">#4A1F40</Color>
    <Color x:Key="AccentColor">#D9744A</Color>
    <Color x:Key="GraphiteColor">#1E2329</Color>

    <!-- ===== Tier 2: brand brushes ===== -->
    <SolidColorBrush x:Key="PrimaryBrush"           Color="{StaticResource Primary500Color}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"      Color="{StaticResource Primary600Color}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush"    Color="{StaticResource Primary700Color}"/>
    <SolidColorBrush x:Key="PrimaryTintBrush"       Color="{StaticResource Primary100Color}"/>
    <SolidColorBrush x:Key="PrimaryDeepBrush"       Color="{StaticResource Primary900Color}"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="HeaderBandBrush"        Color="{StaticResource GraphiteColor}"/>
    <SolidColorBrush x:Key="HeaderBandTextBrush"    Color="#FFFFFF"/>

    <!-- ===== Surfaces / neutrals ===== -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F4F6F8</Color>
    <Color x:Key="BorderColor">#D5DAE1</Color>
    <Color x:Key="TextPrimaryColor">#1E2329</Color>
    <Color x:Key="TextSecondaryColor">#5B6470</Color>

    <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"     Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush2"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondaryColor}"/>

    <!-- ===== Interactive states ===== -->
    <Color x:Key="HoverColor">#E9EDF2</Color>
    <Color x:Key="PressedColor">#DCE2EA</Color>
    <Color x:Key="ItemHoverColor">#F0F3F7</Color>
    <Color x:Key="SelectedColor">#FDE9DE</Color>
    <Color x:Key="FocusColor">#6B2D5C</Color>
    <Color x:Key="DisabledColor">#F1F3F5</Color>
    <Color x:Key="ControlColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="HoverBrush"             Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="PressedBrush"           Color="{StaticResource PressedColor}"/>
    <SolidColorBrush x:Key="ItemHoverBrush"         Color="{StaticResource ItemHoverColor}"/>
    <SolidColorBrush x:Key="SelectedBrush"          Color="{StaticResource SelectedColor}"/>
    <SolidColorBrush x:Key="SelectedTextBrush"      Color="{StaticResource Primary900Color}"/>
    <SolidColorBrush x:Key="FocusBrush"             Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="DisabledBrush"          Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush"      Color="#9AA3AE"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="HeadingBrush"           Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="LabelBrush"             Color="{StaticResource TextPrimaryColor}"/>

    <!-- ===== Semantic (system feedback only - never decoration) ===== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#A16207"/>
    <SolidColorBrush x:Key="ErrorBrush"   Color="#C62828"/>
    <SolidColorBrush x:Key="InfoBrush"    Color="#0369A1"/>

</ResourceDictionary>
