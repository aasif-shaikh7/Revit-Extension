<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Accent (Ember) — same across Light/Dark for brand consistency ===== -->
    <Color x:Key="Ember500Color">#F2994A</Color>
    <Color x:Key="Ember600Color">#D97C2B</Color>
    <Color x:Key="Ember700Color">#C06D20</Color>
    <Color x:Key="Ember100Color">#FCE8D5</Color>
    <Color x:Key="Ember900Color">#7A3F14</Color>

    <SolidColorBrush x:Key="EmberBrush"        Color="{StaticResource Ember500Color}"/>
    <SolidColorBrush x:Key="EmberHoverBrush"   Color="{StaticResource Ember600Color}"/>
    <SolidColorBrush x:Key="EmberPressedBrush" Color="{StaticResource Ember700Color}"/>
    <SolidColorBrush x:Key="EmberTintBrush"    Color="{StaticResource Ember100Color}"/>
    <SolidColorBrush x:Key="EmberDeepBrush"    Color="{StaticResource Ember900Color}"/>

    <!-- ===== Surfaces / neutrals (Dark) ===== -->
    <Color x:Key="SurfaceColor">#2B2B2B</Color>
    <Color x:Key="SurfaceAltColor">#232323</Color>
    <Color x:Key="BorderColor">#3F3F3F</Color>
    <Color x:Key="TextPrimaryColor">#EDEDED</Color>
    <Color x:Key="TextSecondaryColor">#A0A0A0</Color>

    <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"     Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush2"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondaryColor}"/>

    <!-- ===== Interactive states (Dark) ===== -->
    <Color x:Key="HoverColor">#353535</Color>
    <Color x:Key="PressedColor">#3E3E3E</Color>
    <Color x:Key="ItemHoverColor">#333333</Color>
    <Color x:Key="SelectedColor">#4E3823</Color>
    <Color x:Key="FocusColor">#F2994A</Color>
    <Color x:Key="DisabledColor">#2F2F2F</Color>
    <Color x:Key="ControlColor">#333333</Color>

    <SolidColorBrush x:Key="HoverBrush"             Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="PressedBrush"           Color="{StaticResource PressedColor}"/>
    <SolidColorBrush x:Key="ItemHoverBrush"         Color="{StaticResource ItemHoverColor}"/>
    <SolidColorBrush x:Key="SelectedBrush"          Color="{StaticResource SelectedColor}"/>
    <SolidColorBrush x:Key="SelectedTextBrush"      Color="#F2994A"/>
    <SolidColorBrush x:Key="FocusBrush"             Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="DisabledBrush"          Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush"      Color="#6E6E6E"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="HeadingBrush"           Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="LabelBrush"             Color="{StaticResource TextPrimaryColor}"/>

    <!-- ===== System colors ===== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB68B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E0A62B"/>
    <SolidColorBrush x:Key="ErrorBrush"   Color="#E4574C"/>
    <SolidColorBrush x:Key="InfoBrush"    Color="#4C9BE4"/>

</ResourceDictionary>
