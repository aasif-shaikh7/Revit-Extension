<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        UI font: Segoe UI (v1.33.0). It ships with every Windows and Revit
        host, reads well in dense parameter lists, and matches Revit, so
        the dialog feels native. (Sora, used before, was never installed on
        the owner's machine, so it always fell back to Segoe UI anyway.)

        Mono is for things a person copies or compares character by
        character - element IDs, item codes, file paths - never for prose.
    -->
    <FontFamily x:Key="BrandFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="BrandMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- ===== Type scale ===== -->
    <Style x:Key="BrandHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}"/>
    </Style>

    <Style x:Key="BrandSubHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BrandLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BrandBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="BrandCaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="BrandCodeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandMonoFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Default TextBlock style so plain <TextBlock> tags also inherit the brand font -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

</ResourceDictionary>
